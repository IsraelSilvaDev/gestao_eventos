# Django
DJANGO_SECRET_KEY=sua_chave_secreta_aqui_mude_isso
DEBUG=False

# Supabase PostgreSQL
# Pegue esses dados em: Project Settings > Database > Connection string
DB_HOST=db.<SEU_PROJECT_REF>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_supabase
DB_SSL_MODE=require

# Storage (S3-compatible Supabase)
# Crie as chaves em Supabase > Storage > Settings > S3 Access Keys
USE_S3=True
S3_ACCESS_KEY=sua_access_key_s3
S3_SECRET_KEY=sua_secret_key_s3

# Opções de segurança (True se usar HTTPS)
SECURE_SSL_REDIRECT=True
