# Django
DJANGO_SECRET_KEY=sua_chave_secreta_aqui_mude_isso
DEBUG=False

# Supabase PostgreSQL
# Pegue esses dados em: Project Settings > Database > Connection string
DB_HOST=db.<SEU_PROJECT_REF>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_supabase
DB_SSL_MODE=require

# Opções de segurança (True se usar HTTPS)
SECURE_SSL_REDIRECT=True
